{
  "name": "myfinance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "harness": "node .harness/scripts/harness-cli.mjs",
    "check": "node .harness/scripts/harness-cli.mjs check",
    "test": "vitest run",
    "test:harness": "node --test .harness/scripts/*.test.mjs .harness/hooks/*.test.mjs",
    "test:watch": "vitest",
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "typecheck": "tsc -b --pretty false",
    "test:coverage": "vitest run --coverage",
    "verify": "node .harness/scripts/harness-cli.mjs verify",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "5.102.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "5.0.0",
    "axe-core": "4.13.0",
    "jsdom": "^26.1.0",
    "knip": "6.34.0",
    "typescript": "~5.9.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.0",
    "wrangler": "4.129.0"
  }
}
